[Unit]
Description=stock-portal 일 1회 시장 데이터 갱신
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=bh-server
WorkingDirectory=/home/bh-server/stock-portal
# 시스템 파이썬으로 실행하면 psycopg 를 찾지 못한다
ExecStart=/home/bh-server/stock-portal/.venv/bin/python -m collectors.market.daily
StandardOutput=append:/home/bh-server/stock-portal/logs/daily.log
StandardError=append:/home/bh-server/stock-portal/logs/daily.log
