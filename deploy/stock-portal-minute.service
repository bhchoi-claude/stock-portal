[Unit]
Description=stock-portal 분봉 수집 (키움)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=bh-server
WorkingDirectory=/home/bh-server/stock-portal
ExecStart=/home/bh-server/stock-portal/.venv/bin/python -m collectors.market.price_minute
StandardOutput=append:/home/bh-server/stock-portal/logs/minute.log
StandardError=append:/home/bh-server/stock-portal/logs/minute.log
