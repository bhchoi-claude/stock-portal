[Unit]
Description=stock-portal 장중 실측 실험 (일회용, Phase 8)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=bh-server
WorkingDirectory=/home/bh-server/stock-portal

# 08:25 에 시작해 16:12 까지 시각표대로 돈다. 9시간을 준다
TimeoutStartSec=32400

ExecStart=/home/bh-server/stock-portal/.venv/bin/python -m common.broker.testorder

StandardOutput=append:/home/bh-server/stock-portal/logs/testorder.log
StandardError=append:/home/bh-server/stock-portal/logs/testorder.log
