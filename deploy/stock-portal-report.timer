[Unit]
Description=stock-portal 매매 요약 타이머

[Timer]
# 09:15 — 09:00 제출과 첫 체결 추적이 끝난 뒤다. 낮에 화면을 못 보는
# 날에도 '주문이 나갔나' 를 알 수 있다 (2026-09-08 사용자 요청)
OnCalendar=Mon..Fri 09:15 Asia/Seoul

# 15:45 — PROJECT.md 10장의 일일 요약이다. **15:40 이 아니다.**
# 엔진이 15:40 에 daily_pnl 스냅샷을 쓴다. 같은 시각에 읽으면
# 손익이 빈 채로 보고된다
OnCalendar=Mon..Fri 15:45 Asia/Seoul

# 놓친 요약은 보내지 않는다. 지난 시각의 상태 보고는 오해를 부른다
Persistent=false

[Install]
WantedBy=timers.target
