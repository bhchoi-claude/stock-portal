# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.
#   cp .env.example .env && chmod 600 .env
#
# 규칙
#   - = 양옆에 공백을 넣지 않는다
#   - 값에 공백이나 # 가 없으면 따옴표는 불필요하다
#   - 줄 끝에 공백을 남기지 않는다

# --- DB ---
# 비밀번호에 @ : / # 가 들어가면 퍼센트 인코딩해야 한다 (@ 는 %40)
DATABASE_URL=postgresql://portal:PASSWORD@localhost:5432/portal_db

# --- 키움 ---
# 실전과 모의는 앱키가 별도다. 모의 키로 실전 도메인에 접속하면 거부된다.
# 도메인도 함께 갈린다. 모의 mockapi.kiwoom.com / 실전 api.kiwoom.com
KIWOOM_APP_KEY_PAPER=
KIWOOM_APP_SECRET_PAPER=
KIWOOM_APP_KEY_LIVE=
KIWOOM_APP_SECRET_LIVE=

# 계좌번호. DB 에는 저장하지 않는다 (SCHEMA.md 1장)
KIWOOM_ACCOUNT_DAYTRADE=
KIWOOM_ACCOUNT_SWING=
KIWOOM_ACCOUNT_PAPER=

# 키움에 등록한 허용 IP. 현재 IP 와 달라지면 알림을 보낸다
KIWOOM_ALLOWED_IP=

# --- 수집 ---
# opendart.fss.or.kr 무료 가입. 인적분할·증자 구분·현금배당에 쓴다
DART_API_KEY=

# 알림 발송용 봇. 수집과는 별개다
TELEGRAM_BOT_TOKEN=
# 알림을 받을 대화방. 봇에게 아무 메시지나 보낸 뒤
#   curl https://api.telegram.org/bot<토큰>/getUpdates
# 응답의 result[].message.chat.id 값이다. 그룹이면 음수다
TELEGRAM_CHAT_ID=

# 채널 수집용. my.telegram.org 에서 본인 계정으로 발급한다.
# 봇이 아니라 사용자 계정이어야 한다. 채널을 구독한 계정으로만 읽힌다.
#   python -m collectors.news.login  으로 최초 1회 로그인한다
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- 시장분석 지표 (Phase 3) ---
# data.go.kr 계정 하나로 아래 세 API 를 활용신청한다. 셋 다 개발단계
# 자동승인이고 인증키는 계정당 하나다. 개발계정 기준 일 10,000회.
#   금융위원회_금융투자협회종합통계정보 (15094809) -> DEPOSIT, CREDIT_BALANCE
#   관세청_수출입총괄(GW)              (15102108) -> EXPORT_YOY
#   관세청_품목별 수출입실적(GW)        (15101609) -> EXPORT_SEMI_YOY
# 총 수출과 반도체 수출은 API 가 다르다. 품목별은 HS 코드로 뽑는다.
# 포털이 주는 일반 인증키(Decoding) 를 넣는다
DATA_GO_KR_API_KEY=

# ecos.bok.or.kr 회원가입 시 자동 발급. 보통 1일 이내에 호출이 열린다
#   -> USDKRW
ECOS_API_KEY=

# VKOSPI, KOSPI 200일 이평 이격도, 시장 등락률은 키움에서 받는다.
# 별도 키가 필요 없다 (ka20006 업종일봉, 2026-08-28 실측)

# --- KRX 오픈API ---
# 인증키와 별개로 API 마다 이용신청이 필요하다
# 종목기본정보는 유가증권·코스닥·코넥스 세 서비스를 각각 신청한다
KRX_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=

# 조직 계정 키는 워크스페이스를 함께 보내야 한다. 없으면 400 이 난다.
# platform.claude.com 의 주소 /workspaces/<여기> 에 있다.
# 개인 키라면 비워둔다
ANTHROPIC_WORKSPACE_ID=
