[Unit]
Description=stock-portal 스윙 매매 엔진
After=network-online.target postgresql.service
Wants=network-online.target

# 계속 실패하면 포기하고 멈춘다. 무한 재시작은 로그만 채우고 화면에는
# 살아 있는 것처럼 보인다 (deploy/stock-portal-news.service 와 같은 판단)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bh-server
WorkingDirectory=/home/bh-server/stock-portal

# always 가 아니라 on-failure 다. 포털의 정지 명령을 받으면 엔진은 0 으로
# 끝나는데, always 면 systemd 가 30초 뒤 되살려 정지가 무의미해진다.
# 크래시(0 이 아닌 종료)만 되살린다.
#
# 재시작마다 증권사와 대조하므로 (INTERFACES.md 2.2) 몰아치지 않게 여유를 둔다
Restart=on-failure
RestartSec=30

# **버퍼를 끈다.** StandardError=append 는 파이프가 아니라 파일이라
# Python 이 블록 버퍼로 잡는다. 24시간 상주라 종료 시 flush 를 기대할 수 없다 —
# 로그가 통째로 안 보인다 (2026-09-03 엔진 기동에서 겪었다)
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/bh-server/stock-portal/.venv/bin/python -m engines.swing

StandardOutput=append:/home/bh-server/stock-portal/logs/swing.log
StandardError=append:/home/bh-server/stock-portal/logs/swing.log

[Install]
WantedBy=multi-user.target
