[Unit]
Description=stock-portal 정보수집 분석·집계
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=bh-server
WorkingDirectory=/home/bh-server/stock-portal

# 앞이 실패해도 뒤를 돌린다. 집계는 이미 쌓인 언급만으로도 할 일이 있고,
# 분석 실패 때문에 급등 알림까지 멈추면 안 된다
ExecStart=-/home/bh-server/stock-portal/.venv/bin/python -m collectors.news.analyze
ExecStart=-/home/bh-server/stock-portal/.venv/bin/python -m collectors.news.aggregate

StandardOutput=append:/home/bh-server/stock-portal/logs/news.log
StandardError=append:/home/bh-server/stock-portal/logs/news.log
